# ===========================================================================
# OMEN AI backend — environment variables
# Copy to `.env` for local dev (never commit real secrets). On Railway, set
# these in the service Variables. See CLAUDE.md for full descriptions.
# ===========================================================================

# --- Django core -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=omen.settings.dev      # use omen.settings.prod on Railway
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1                                        # 0 in production
ALLOWED_HOSTS=localhost,127.0.0.1              # comma list; add your Railway domain
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Postgres. On Railway: add the Postgres plugin and reference it as
# DATABASE_URL=${{Postgres.DATABASE_URL}} in the service variables. If unset,
# SQLite is used as a local fallback.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- CORS / frontend -------------------------------------------------------
# Comma list of allowed frontend origins (CORS + CSRF). Prod defaults to the
# Lovable app + custom domain; *.lovable.app preview subdomains are also allowed.
FRONTEND_ORIGIN=http://localhost:8080
# Production example:
# FRONTEND_ORIGIN=https://omtas.lovable.app,https://omen.devmate.in
# CSRF_TRUSTED_ORIGINS=https://omtas.lovable.app,https://omen.devmate.in

# --- Auth ------------------------------------------------------------------
DEV_LOGIN=1                                    # 1 => passwordless login for seeded users (dev only)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Storage --------------------------------------------------------------
# Absolute base URL of THIS API, used to build signed media/report URLs (esp.
# from the worker, which has no request). Set on Railway to your service URL.
PUBLIC_BASE_URL=
# PUBLIC_BASE_URL=https://omen.up.railway.app

# AWS S3 (private bucket; presigned PUT/GET). Leave these unset to use the
# DB-backed "mock S3" store (files saved as bytes in the DB; USE_S3 auto-detects).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_PRESIGN_EXPIRY=3600                      # also the signed mock-URL TTL (s)

# --- AI providers ----------------------------------------------------------
# Leave both keys unset to run fully mocked (AI_MOCK auto-enables offline).
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Force mock mode even if keys are present (useful for CI):
# AI_MOCK=1

# Router resilience
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Per-task model/provider overrides (optional) --------------------------
# Override any task's model or provider without touching code. Task names match
# the TaskType enum (uppercased): ASR, TRANSLATE, CLASSIFY, DOC_EXTRACT,
# IMAGE_ANALYZE, FORM_AUTOFILL, NARRATIVE, RISK_CHECK, MARKET_RATE_SEARCH, EMBED.
# AI_MODEL_FORM_AUTOFILL=deepseek-ai/DeepSeek-V3.2
# AI_PROVIDER_FORM_AUTOFILL=deepinfra

# --- Production security (prod settings) -----------------------------------
# SECURE_SSL_REDIRECT=1
